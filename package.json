{
  "name": "systems-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "postinstall": "fumadocs-mdx",
    "build": "tsx scripts/validate-content.ts && next build --webpack",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "tsx scripts/validate-content.ts",
    "test": "tsx --test scripts/*.test.ts",
    "ai-review": "tsx scripts/ai-review.ts",
    "test:export": "tsx scripts/test-export.ts"
  },
  "dependencies": {
    "@giscus/react": "3.1.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
