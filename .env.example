# Origin only; do not include the repository path here.
NEXT_PUBLIC_SITE_URL=https://username.github.io
# Empty for a custom domain or username.github.io repository; otherwise /repository
NEXT_PUBLIC_BASE_PATH=/repository
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
# CI-only credentials; never use NEXT_PUBLIC_ for these.
AI_API_KEY=
AI_PROVIDER=openai-compatible
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
